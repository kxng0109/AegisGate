# Environment variables for AegisGate
# Copy to .env and fill in your values
# Only variable names are documented here; values belong in your environment.

# Upstream provider API keys
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_POOL_MAX_ACTIVE=20

# Redis Sentinel (optional; only needed when using a sentinel topology)
# Configure via Boot's standard spring.data.redis.sentinel.* namespace. These bind directly to
# DataRedisProperties, so they take effect only when you set them (do NOT add an empty sentinel: block to
# application.yml -- Boot validates the master eagerly and fails context startup without it).
# REDIS_SENTINEL_USERNAME / REDIS_SENTINEL_PASSWORD authenticate against the sentinel nodes themselves,
# distinct from the data-node REDIS_HOST credentials.
SPRING_DATA_REDIS_SENTINEL_MASTER=
SPRING_DATA_REDIS_SENTINEL_NODES=
SPRING_DATA_REDIS_SENTINEL_USERNAME=
SPRING_DATA_REDIS_SENTINEL_PASSWORD=

# PostgreSQL backing the usage ledger and pricing catalog
POSTGRES_URL=jdbc:postgresql://localhost:5432/aegisgate
POSTGRES_USER=aegisgate
POSTGRES_PASSWORD=

# Bootstrap key provisioning (repeat the block for each key)
GATEWAY_BOOTSTRAPKEYS_0_OWNERID=local
GATEWAY_BOOTSTRAPKEYS_0_NAME=local-dev
GATEWAY_BOOTSTRAPKEYS_0_PLAINTEXTKEY=gw-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GATEWAY_BOOTSTRAPKEYS_0_RPMLIMIT=60
GATEWAY_BOOTSTRAPKEYS_0_TPMLIMIT=100000
GATEWAY_BOOTSTRAPKEYS_0_ALLOWEDMODELS=
GATEWAY_BOOTSTRAPKEYS_0_ALLOWEDPROVIDERS=

# Pricing catalog sync
GATEWAY_PRICING_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
GATEWAY_PRICING_REFRESH_CRON=0 0 3 * * *

# Ledger dead letter fallback
GATEWAY_LEDGER_DEAD_LETTER_PATH=logs/ledger-deadletter.log

# Non fatal database migration retry
GATEWAY_DATABASE_MIGRATE_ENABLED=true
GATEWAY_DATABASE_MIGRATE_INTERVAL=30s