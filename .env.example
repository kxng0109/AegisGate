# Environment variables for AegisGate
# Copy to .env and fill in your values
# Only variable names are documented here; values belong in your environment.

# Upstream provider API keys
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Upstream provider timeouts (defaults: 5s connect / 60s request, ollama 3s/120s)
OPENAI_CONNECT_TIMEOUT=
OPENAI_REQUEST_TIMEOUT=
OPENROUTER_CONNECT_TIMEOUT=
OPENROUTER_REQUEST_TIMEOUT=
ANTHROPIC_CONNECT_TIMEOUT=
ANTHROPIC_REQUEST_TIMEOUT=
OLLAMA_CONNECT_TIMEOUT=
OLLAMA_REQUEST_TIMEOUT=

# Master admin key (required for /v1/admin/** management endpoints)
GATEWAY_ADMIN_MASTERKEY=

# HITL AEAD secret (REQUIRED — 32+ bytes; the app refuses to start without it)
# Generate with: openssl rand -base64 32
GATEWAY_MCP_HITL_SECRET=

# Spring profile: default serves light/moderate load; "high-throughput" unlocks
# the 100K rps / 50K-stream ceilings (needs tuned Redis/PG/kernel/JVM)
SPRING_PROFILES_ACTIVE=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_POOL_MAX_ACTIVE=20
REDIS_POOL_MAX_IDLE=10
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_WAIT=2s

# Redis Sentinel (optional; only needed when using a sentinel topology)
# Configure via Boot's standard spring.data.redis.sentinel.* namespace. These bind directly to
# DataRedisProperties, so they take effect only when you set them (do NOT add an empty sentinel: block to
# application.yml -- Boot validates the master eagerly and fails context startup without it).
# REDIS_SENTINEL_USERNAME / REDIS_SENTINEL_PASSWORD authenticate against the sentinel nodes themselves,
# distinct from the data-node REDIS_HOST credentials.
SPRING_DATA_REDIS_SENTINEL_MASTER=
SPRING_DATA_REDIS_SENTINEL_NODES=
SPRING_DATA_REDIS_SENTINEL_USERNAME=
SPRING_DATA_REDIS_SENTINEL_PASSWORD=

# PostgreSQL backing the usage ledger and pricing catalog
POSTGRES_URL=jdbc:postgresql://localhost:5432/aegisgate
POSTGRES_USER=aegisgate
POSTGRES_PASSWORD=
HIKARI_MAXIMUM_POOL_SIZE=10
HIKARI_MINIMUM_IDLE=10
HIKARI_MAX_LIFETIME=1800000

# Bootstrap key provisioning (repeat the block for each key)
GATEWAY_BOOTSTRAPKEYS_0_OWNERID=local
GATEWAY_BOOTSTRAPKEYS_0_NAME=local-dev
GATEWAY_BOOTSTRAPKEYS_0_PLAINTEXTKEY=gw-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GATEWAY_BOOTSTRAPKEYS_0_RPMLIMIT=60
GATEWAY_BOOTSTRAPKEYS_0_TPMLIMIT=100000
GATEWAY_BOOTSTRAPKEYS_0_ALLOWEDMODELS=
GATEWAY_BOOTSTRAPKEYS_0_ALLOWEDPROVIDERS=

# Pricing catalog sync
GATEWAY_PRICING_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
GATEWAY_PRICING_REFRESH_CRON=0 0 3 * * *

# Ledger dead letter fallback
GATEWAY_LEDGER_DEAD_LETTER_PATH=logs/ledger-deadletter.log

# Non fatal database migration retry
GATEWAY_DATABASE_MIGRATE_ENABLED=true
GATEWAY_DATABASE_MIGRATE_INTERVAL=30s

# Ingress + shared proxy client
GATEWAY_INGRESS_MAX_BODY_BYTES=1048576
GATEWAY_PROXY_CONNECT_TIMEOUT_SECONDS=5

# Rate limiting (window, token-estimate clamps, key-resolution cache)
GATEWAY_RATELIMIT_WINDOW_MILLIS=60000
GATEWAY_RATELIMIT_MIN_ESTIMATED_TOKENS=1
GATEWAY_RATELIMIT_MAX_ESTIMATED_TOKENS=1000000
GATEWAY_RATELIMIT_KEY_CACHE_MAXIMUM_SIZE=1000
GATEWAY_RATELIMIT_KEY_CACHE_TTL_SECONDS=5

# Embeddings batching + provider fan-out
GATEWAY_EMBEDDINGS_MAX_BATCH_ITEMS=2048
GATEWAY_EMBEDDINGS_MAX_CONCURRENT_SUB_REQUESTS=4
GATEWAY_EMBEDDINGS_COHERE_TIMEOUT_SECONDS=30
GATEWAY_EMBEDDINGS_COHERE_MAX_BATCH_SIZE=96

# Pricing snapshot cache
GATEWAY_PRICING_SNAPSHOT_TTL_MINUTES=15
GATEWAY_PRICING_SNAPSHOT_MAXIMUM_SIZE=1

# Ledger executor pool, micro-batch writer, spillway replay, admin query caps
GATEWAY_LEDGER_EXECUTOR_CORE_POOL_SIZE=2
GATEWAY_LEDGER_EXECUTOR_MAX_POOL_SIZE=4
GATEWAY_LEDGER_EXECUTOR_QUEUE_CAPACITY=1000
GATEWAY_LEDGER_EXECUTOR_AWAIT_TERMINATION_SECONDS=10
GATEWAY_LEDGER_BATCH_MAX_SIZE=5000
GATEWAY_LEDGER_BATCH_INTERVAL_MS=50
GATEWAY_LEDGER_REPLAY_INITIAL_DELAY_MS=30000
GATEWAY_LEDGER_REPLAY_INTERVAL_MS=60000
GATEWAY_LEDGER_SHUTDOWN_AWAIT_SECONDS=5
GATEWAY_LEDGER_QUERY_MAX_WINDOW_DAYS=90
GATEWAY_LEDGER_QUERY_MAX_PAGE_SIZE=100
GATEWAY_LEDGER_QUERY_DEFAULT_PAGE_SIZE=20
GATEWAY_LEDGER_QUEUE_CAPACITY=65536

# Circuit breaker Redis timeout
GATEWAY_CIRCUIT_BREAKER_REDIS_TIMEOUT=250ms

# MCP catalog cache + legacy SSE emitter lifetime
GATEWAY_MCP_CATALOG_CACHE_MAXIMUM_SIZE=16
GATEWAY_MCP_LEGACY_SSE_EMITTER_TIMEOUT_MINUTES=30

# SSE flush tuning (hot-reloadable) + startup-only capacity ceilings
AEGIS_SSE_FLUSH_MAX_LINES_PER_FLUSH=16
AEGIS_SSE_FLUSH_MAX_INTERVAL_MS=100
AEGIS_SSE_FLUSH_BACKPRESSURE_THRESHOLD_MS=500
AEGIS_SSE_FLUSH_MAX_BUFFER_BYTES=65536
AEGIS_SSE_FLUSH_MAX_FLUSHES_PER_SECOND=1000
AEGIS_SSE_FLUSH_ENABLED=true
AEGIS_SSE_FLUSH_RELOAD_INTERVAL=30s
AEGIS_SSE_CAPACITY_MAX_CONNECTIONS=10000
AEGIS_SSE_CAPACITY_TICK_PERIOD_MS=10
AEGIS_SSE_CAPACITY_WATCHDOG_TIMEOUT_MS=30000

# Tomcat (high-throughput profile; unset = Boot defaults, max-connections 8192)
TOMCAT_MAX_CONNECTIONS=
TOMCAT_ACCEPT_COUNT=
TOMCAT_THREADS_MAX=
TOMCAT_THREADS_MIN_SPARE=
TOMCAT_KEEP_ALIVE_TIMEOUT=
TOMCAT_MAX_KEEP_ALIVE_REQUESTS=
TOMCAT_CONNECTION_TIMEOUT=

# NOTE: container FD limits (ulimits.nofile) are plain integers in
# docker-compose.yml — Compose rejects interpolated strings there, so they are
# tuned by editing compose directly, not via environment.