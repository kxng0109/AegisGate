# -----------------------------------------------------------------------------
# AegisGate Docker Compose Configuration Template
# Copy this file to .env before starting containers: `cp .env.docker.example .env`
# -----------------------------------------------------------------------------

# Ports
GATEWAY_PORT=8080
REDIS_PORT=6379
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Observability & Monitoring (Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=aegisgate_secret
GRAFANA_AUTH_ANONYMOUS_ENABLED=true

# PostgreSQL Configuration
POSTGRES_DB=aegisgate
POSTGRES_USER=aegisgate
POSTGRES_PASSWORD=aegisgate_secret

# Upstream Provider Keys (insert your real provider API keys here)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Master Admin Key (required for /v1/admin/** management endpoints)
GATEWAY_ADMIN_MASTERKEY=aegisgate_admin_secret_key

# SSRF allowlist for local development backends (exact hostnames only, comma
# separated; e.g. localhost,host.docker.internal). Empty by default: every private
# address target fails closed. Add ONLY explicitly-trusted development hosts here.
GATEWAY_DEV_ALLOW_PRIVATE_HOSTS=localhost,host.docker.internal

# HITL AEAD secret (REQUIRED — 32+ bytes; the app refuses to start without it)
# Generate with: openssl rand -base64 32
GATEWAY_MCP_HITL_SECRET=REPLACE_WITH_32_PLUS_BYTE_SECRET

# Spring profile: default serves light/moderate load; "high-throughput" unlocks
# the 100K rps / 50K-stream ceilings (needs tuned Redis/PG per docs/high-throughput/)
SPRING_PROFILES_ACTIVE=default

# Redis pool (compose service)
REDIS_POOL_MAX_ACTIVE=20
REDIS_POOL_MAX_IDLE=10
REDIS_POOL_MIN_IDLE=2

# PostgreSQL pool (compose service)
HIKARI_MAXIMUM_POOL_SIZE=10
HIKARI_MINIMUM_IDLE=10

# Local Ollama (host gateway). Containers cannot reach the host's localhost:11434
# directly; point at the host gateway (Ollama needs no network-access toggle).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Capacity ceilings (defaults serve light/moderate load; see .env.example for all)
AEGIS_SSE_CAPACITY_MAX_CONNECTIONS=10000
GATEWAY_LEDGER_EXECUTOR_CORE_POOL_SIZE=2
GATEWAY_LEDGER_EXECUTOR_MAX_POOL_SIZE=4
GATEWAY_LEDGER_EXECUTOR_QUEUE_CAPACITY=1000
GATEWAY_RATELIMIT_KEY_CACHE_MAXIMUM_SIZE=1000
GATEWAY_RATELIMIT_WINDOW_MILLIS=60000

# Semantic (L2) cache embedding alias. Resolved via gateway.providers/aliases
# like any other request; default local-embed works on the local Ollama stack.
# Set to text-embedding-3-small (or any alias) for a different embedding model.
GATEWAY_CACHE_SEMANTIC_EMBEDDING_MODEL=local-embed

# Container FD limits
ULIMIT_NOFILE_SOFT=65536
ULIMIT_NOFILE_HARD=100000

# Local Development Bootstrap Key (pre-seeded virtual key for instant curl requests)
# Must start with gw- followed by 32 base64url characters (key is rejected otherwise)
GATEWAY_BOOTSTRAPKEYS_0_OWNERID=local
GATEWAY_BOOTSTRAPKEYS_0_NAME=local-dev
GATEWAY_BOOTSTRAPKEYS_0_PLAINTEXTKEY=gw-localdevmasterkey0123456789abcde
GATEWAY_BOOTSTRAPKEYS_0_RPMLIMIT=120
GATEWAY_BOOTSTRAPKEYS_0_TPMLIMIT=500000
GATEWAY_BOOTSTRAPKEYS_0_ALLOWEDMODELS=
GATEWAY_BOOTSTRAPKEYS_0_ALLOWEDPROVIDERS=

# Load-Test Bootstrap Key (high RPM ceiling so k6 floods are NOT rate-limited;
# set LOAD_KEY=gw-0123456789abcdef0123456789abcdef in the k6 env to use it).
# 60000 RPM covers the 500 rps flood (30K req/min) with headroom; kept separate
# from the 120 RPM dev key so rate-integrity stays observable.
GATEWAY_BOOTSTRAPKEYS_1_OWNERID=load
GATEWAY_BOOTSTRAPKEYS_1_NAME=load-test
GATEWAY_BOOTSTRAPKEYS_1_PLAINTEXTKEY=gw-0123456789abcdef0123456789abcdef
GATEWAY_BOOTSTRAPKEYS_1_RPMLIMIT=60000
GATEWAY_BOOTSTRAPKEYS_1_TPMLIMIT=10000000
